/*
 * Styling is driven entirely by Textual theme variables so the UI adapts to
 * both the dark ("midnight-gold") and light ("daylight-gold") themes. The
 * signature gold accent is exposed through the custom $gold / $gold-soft
 * variables registered in app.py.
 */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $gold-soft;
}

Footer {
    background: $panel;
    color: $foreground;
}

#app-shell {
    layout: vertical;
    height: 1fr;
}

#status-bar {
    height: auto;
    padding: 1 2;
    layout: horizontal;
    background: $surface;
    border-bottom: solid $panel-lighten-2;
}

#brand-card {
    width: 34;
    min-width: 34;
    padding: 1 2;
    background: $panel;
    border: tall $gold;
    color: $gold-soft;
    margin-right: 1;
}

.status-chip {
    min-width: 24;
    width: 1fr;
    margin-right: 1;
    padding: 1 2;
    background: $panel;
    border: round $panel-lighten-2;
    color: $foreground;
}

.status-chip:last-child {
    margin-right: 0;
}

TabbedContent {
    background: transparent;
    border: none;
}

TabPane {
    padding: 1;
}

.panel {
    background: $panel;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 0 1 1 0;
}

.panel-title {
    color: $gold-soft;
    text-style: bold;
}

#dashboard-grid {
    layout: grid;
    grid-size: 2 3;
    grid-columns: 2fr 1.2fr;
    grid-rows: 12 12 1fr;
    grid-gutter: 1;
    height: 1fr;
}

#dashboard-summary,
#dashboard-detail,
#dashboard-pomodoro,
#dashboard-focus,
#dashboard-stats {
    height: 100%;
}

#dashboard-tasks-panel {
    height: 100%;
}

DataTable {
    background: $surface;
    border: round $panel-lighten-2;
    color: $foreground;
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $gold 30%;
    color: $text;
}

#tasks-layout,
#focus-layout,
#statistics-layout,
#settings-layout {
    layout: horizontal;
    height: 1fr;
}

#tasks-main,
#focus-main,
#stats-main,
#settings-main {
    width: 2fr;
    height: 1fr;
}

#tasks-side,
#focus-side,
#stats-side,
#settings-side {
    width: 1fr;
    height: 1fr;
}

#tasks-side .panel,
#focus-side .panel,
#stats-side .panel,
#settings-side .panel {
    margin-right: 0;
}

Input, Select {
    margin-bottom: 1;
    background: $surface;
    border: round $panel-lighten-2;
}

Button {
    margin-right: 1;
}

.muted {
    color: $text-muted;
}

.accent {
    color: $gold-soft;
}

.success {
    color: $success;
}

.warning {
    color: $warning;
}

.danger {
    color: $error;
}

#help-pane Static {
    background: $panel;
    border: round $panel-lighten-2;
    padding: 1 2;
}
