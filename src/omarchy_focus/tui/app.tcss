/*
 * Night-flight console: information stays quiet until it becomes the next
 * action. Theme variables keep the same hierarchy in light and dark modes.
 */

Screen {
    background: $background;
    color: $foreground;
}

ModalScreen {
    background: $background 90%;
}

Header {
    background: $panel;
    color: $gold-soft;
}

Footer {
    background: $panel;
    color: $foreground;
}

#app-shell {
    layout: vertical;
    height: 1fr;
}

#status-bar {
    height: 6;
    padding: 1 2;
    layout: horizontal;
    background: $surface;
    border-bottom: solid $panel-lighten-2;
}

#brand-card {
    width: 29;
    min-width: 29;
    padding: 0 2;
    background: $panel;
    border-left: thick $gold;
    color: $gold-soft;
    margin-right: 1;
    content-align: left middle;
}

.status-chip {
    min-width: 18;
    width: 1fr;
    height: 100%;
    margin-right: 1;
    padding: 0 2;
    background: $panel;
    border-bottom: solid $panel-lighten-2;
    color: $foreground;
    content-align: left middle;
}

.status-chip:last-child {
    margin-right: 0;
}

TabbedContent {
    background: transparent;
    border: none;
}

Tabs {
    background: $surface;
    color: $text-muted;
}

Tab.-active {
    color: $gold-soft;
    text-style: bold;
}

TabPane {
    padding: 1 2;
}

.panel {
    background: $panel;
    border-left: solid $panel-lighten-3;
    padding: 1 2;
    margin: 0 1 1 0;
}

.hero-panel {
    height: 10;
    background: $panel;
    border: tall $gold;
    padding: 1 3;
    color: $gold-soft;
    text-style: bold;
    content-align: left middle;
}

.eyebrow,
.view-title,
.panel-title {
    color: $gold-soft;
    text-style: bold;
}

.view-title {
    height: 2;
    padding-left: 1;
}

#dashboard-layout {
    layout: horizontal;
    height: 1fr;
}

#dashboard-main {
    width: 2fr;
    height: 1fr;
    margin-right: 1;
}

#dashboard-side {
    width: 1fr;
    height: 1fr;
}

#dashboard-side .panel {
    width: 100%;
    height: 1fr;
    margin-right: 0;
}

#dashboard-actions {
    height: 4;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

#dashboard-actions Button {
    width: 1fr;
    min-width: 16;
    margin-right: 1;
}

#dashboard-actions Button:last-child {
    margin-right: 0;
}

#dashboard-tasks-panel {
    height: 1fr;
    margin: 0;
}

#dashboard-tasks-panel .eyebrow {
    height: 2;
}

DataTable {
    background: $surface;
    border: solid $panel-lighten-2;
    color: $foreground;
    height: 1fr;
}

DataTable > .datatable--cursor {
    background: $gold 30%;
    color: $text;
    text-style: bold;
}

.empty-state {
    height: 1fr;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    padding: 2;
}

#tasks-layout,
#focus-layout,
#statistics-layout,
#settings-layout {
    layout: horizontal;
    height: 1fr;
}

#tasks-main,
#focus-main,
#stats-main,
#settings-main {
    width: 2fr;
    height: 1fr;
}

#tasks-side,
#focus-side,
#stats-side,
#settings-side {
    width: 1fr;
    height: 1fr;
}

#tasks-side .panel,
#focus-side .panel,
#stats-side .panel,
#settings-side .panel {
    margin-right: 0;
}

#task-detail {
    height: 2fr;
}

#task-quick-actions {
    height: 1fr;
}

.filter-line {
    height: 2;
    color: $text-muted;
    padding: 0 1;
}

Input,
Select {
    margin-bottom: 1;
    background: $surface;
    border: solid $panel-lighten-2;
}

Input:focus,
Select:focus {
    border: tall $gold;
}

Button {
    margin-right: 1;
}

Button:focus {
    text-style: bold;
}

.muted {
    color: $text-muted;
}

.accent {
    color: $gold-soft;
}

.success {
    color: $success;
}

.warning {
    color: $warning;
}

.danger {
    color: $error;
}

.compact #brand-card {
    display: none;
}

.compact #status-bar {
    height: 5;
    padding: 0 1;
}

.compact .status-chip {
    min-width: 0;
    margin-right: 0;
    padding: 0 1;
}

.compact #dashboard-main {
    width: 1fr;
    margin-right: 0;
}

.compact #dashboard-side {
    display: none;
}

.compact #dashboard-actions Button {
    min-width: 10;
    padding: 0 1;
}

.compact #task-quick-actions,
.compact #settings-hints {
    display: none;
}

.compact #tasks-main,
.compact #settings-main {
    width: 3fr;
}

.compact #tasks-side,
.compact #settings-side {
    width: 2fr;
}

#help-pane Static {
    background: $panel;
    border-left: solid $gold;
    padding: 1 2;
}
